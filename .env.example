# This site's first env-var dependency — everything else here is fully
# static (see README/CLAUDE.md), so there's nothing else to configure.

# On-demand ISR revalidation (app/api/revalidate/route.ts), called by the OS
# app right after a photo is published to the gallery, so it shows up here
# immediately instead of waiting out the gallery's own 60s ISR window
# (lib/api.ts). Optional — without it, /api/revalidate always no-ops with
# {ok:true, skipped:"not_configured"} rather than accepting unauthenticated
# revalidation requests. Must match REVALIDATE_SECRET in the OS app's own
# env vars (bright-academy-os/.env.example).
REVALIDATE_SECRET=
